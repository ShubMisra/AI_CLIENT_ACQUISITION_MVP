# None of these credentials are required to launch the local dashboard.
# Optional third-party authorization for new leads:
BRAVE_API_KEY=
FREELANCER_OAUTH_TOKEN=
# Optional locally running Ollama model for deeper reasoning:
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
# Optional founder API token. For remote use, put behind HTTPS reverse proxy and real auth.
ACQ_ADMIN_TOKEN=
# File path for the persistent local database:
ACQ_DB_PATH=./data/acquisition.db
